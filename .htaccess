# Blokir akses langsung ke file sensitif dan artefak pengembangan.
Options -Indexes

<FilesMatch "\.(sql|bak|log|env|ini|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir folder yang tidak boleh diakses dari browser.
RedirectMatch 404 (?i)/(database|mailoutput)(/|$)
